# ─── ClaimIQ Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4012

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute path to SQLite database file.
# Default: <project root>/claimiq.db
DB_PATH=/var/www/claimiq/claimiq.db

# Absolute path to uploaded files directory.
# Default: <project root>/uploads/
UPLOADS_DIR=/var/www/claimiq/uploads

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a long random string: openssl rand -base64 64
SESSION_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Used for trustee confirmation emails and admin bid summaries.
# Supports any SMTP provider (Gmail, SendGrid, Mailgun, AWS SES, etc.)
# If left blank, emails are logged to console only.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false        # true for port 465, false for 587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# From address shown on all outgoing emails
EMAIL_FROM="ClaimIQ <noreply@claimiq.com>"

# Admin email: where bid summary notifications are sent
ADMIN_EMAIL=planet44555@gmail.com

# ── Analytics (optional) ──────────────────────────────────────────────────────
# POSTHOG_KEY=phc_xxxx
